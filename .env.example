# =====================================================================
# AUTOPILOT — .env.example
# Isko copy karke `.env` naam do:  cp .env.example .env
# Phir apni keys bharo. .env kabhi GitHub pe mat daalo (.gitignore mein hai).
# PHASE 1 ke liye in mein se KUCH BHI zaroori nahi — mock mode chal jayega.
# =====================================================================

# ---------- GEMINI (Google AI Studio) ----------
# Kahan se: https://aistudio.google.com/apikey  (free, credit card nahi chahiye)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ---------- MOONSHOT AI / KIMI K3 (Paid OpenAI-compatible provider) ----------
# Kahan se: https://platform.moonshot.cn/console/api-keys (paid API, apna key daalo)
MOONSHOT_API_KEY=
# Moonshot model name (default kimi-k3, change if needed):
MOONSHOT_MODEL=kimi-k3
# Moonshot API base endpoint (default https://api.moonshot.ai/v1):
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1

# ---------- LLM ROUTING & FALLBACK ----------
# Provider selection: auto (default) | gemini | kimi (alias: moonshot)
LLM_PROVIDER=auto
# Primary provider if both keys exist in auto mode: gemini (default) | kimi
LLM_PRIMARY=gemini
# Optional explicit fallback order (comma-separated, overrides above): e.g. kimi,gemini,mock
# LLM_FALLBACK_ORDER=gemini,kimi,mock

# ---------- YOUTUBE (Phase 5) ----------
# Google Cloud Console -> APIs -> Credentials -> OAuth client ID (Desktop app)
# client_secret.json download karke project folder mein rakho
YT_CLIENT_SECRET_FILE=client_secret.json
YT_TOKEN_FILE=token.json
YT_CHANNEL_ID=

# ---------- INSTAGRAM / META (Phase 6) ----------
# developers.facebook.com -> apna app -> Instagram Graph API
# ⚠️ Instagram account BUSINESS ya CREATOR hona chahiye + Facebook Page se linked.
#    Personal account API se post nahi kar sakta.
# Ye dono kaise laayein: SETUP.md STEP 6c (Graph API Explorer se, 5 minute)
IG_APP_ID=
IG_APP_SECRET=
IG_LONG_LIVED_TOKEN=
IG_BUSINESS_ACCOUNT_ID=
IG_API_VERSION=v21.0

# ---------- VIDEO HOSTING (Phase 6) ----------
# ⚠️ IG local file upload NAHI leta. Video ek PUBLIC URL pe hona chahiye —
#    Meta ke server usse khud download karte hain.
#
# Modes: github_release (RECOMMENDED) | catbox | manual | r2
PUBLIC_HOST_MODE=github_release

# --- github_release ke liye (2 GB/file, unlimited bandwidth, free) ---
# Token: github.com/settings/tokens -> classic -> 'repo' scope tick karo
# Repo PRIVATE bhi ho sakta hai — releases phir bhi public rehte hain
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_RELEASE_TAG=videos

# --- r2 ke liye (optional) ---
R2_BUCKET=
R2_PUBLIC_URL=

# ---------- MAKE.COM / AUTOMATION WEBHOOK ----------
# Ye secret /api/webhook call ke liye zaroori hai — min 32 chars
# Secret generate karne ke liye: python -c "import secrets; print(secrets.token_urlsafe(32))"
MAKE_WEBHOOK_SECRET=

# ---------- TELEGRAM (Phase 9 daily digest notifications) ----------
# @BotFather se bot banao aur token yahan daalo:
TELEGRAM_BOT_TOKEN=
# Apna chat ID daalo (@userinfobot se mil jayega):
TELEGRAM_CHAT_ID=

# ---------- RUNTIME OVERRIDES (config.yaml ko override karte hain) ----------
# AUTOPILOT_MOCK_MODE=false
# AUTOPILOT_AUTONOMY=review_first

