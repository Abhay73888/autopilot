# =====================================================================
# AUTOPILOT — PRODUCTION SaaS & LOCAL CONFIGURATION (.env.example)
# Copy this file to `.env`:  cp .env.example .env
# Never commit `.env` to source control.
# =====================================================================

# ---------- ENVIRONMENT & PORT ----------
ENV=development
PORT=8765
HOST=0.0.0.0
APP_SECRET_KEY=generate_with_python_secrets_token_hex_32

# ---------- MULTI-TENANT DATABASE (PostgreSQL / Supabase) ----------
# Production: postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres
# Leave empty to run local SQLite database (default for offline dev)
DATABASE_URL=
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ---------- DISTRIBUTED ASYNC QUEUE (Redis / Upstash) ----------
# Production: rediss://default:[PASSWORD]@[HOST]:6379
# Leave empty for in-memory queue fallback
REDIS_URL=
REDIS_PASSWORD=

# ---------- OBJECT STORAGE (Cloudflare R2 / AWS S3) ----------
STORAGE_PROVIDER=local
# Options: local | r2 | s3
STORAGE_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
STORAGE_BUCKET=autopilot-production-assets
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_BASE_URL=https://assets.autopilot.ai

# ---------- BILLING & PAYMENTS (Stripe / LemonSqueezy / Dodo) ----------
BILLING_PROVIDER=stripe
# Options: stripe | lemonsqueezy | dodo
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_WEBHOOK_SECRET=

# ---------- SENTRY OBSERVABILITY ----------
SENTRY_DSN=

# ---------- AI LLM PROVIDERS ----------
# Primary / Fallback: gemini | openai | anthropic | kimi | groq
LLM_PROVIDER=auto
LLM_PRIMARY=gemini

# Google AI Studio (Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Anthropic (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Groq (Ultra-fast Llama-3 / Mixtral)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Moonshot AI / Kimi K3
MOONSHOT_API_KEY=
MOONSHOT_MODEL=kimi-k3
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1

# ---------- TEXT-TO-SPEECH (TTS) PROVIDERS ----------
# Options: edge (free) | elevenlabs | local
TTS_PROVIDER=edge
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ---------- IMAGE & VIDEO GENERATION (Fal.ai / Replicate) ----------
FAL_KEY=
REPLICATE_API_TOKEN=

# ---------- YOUTUBE DATA API (OAuth 2.0) ----------
YT_CLIENT_SECRET_FILE=client_secret.json
YT_TOKEN_FILE=token.json
YT_CHANNEL_ID=

# ---------- INSTAGRAM / META GRAPH API ----------
IG_APP_ID=
IG_APP_SECRET=
IG_LONG_LIVED_TOKEN=
IG_BUSINESS_ACCOUNT_ID=
IG_API_VERSION=v21.0

# Meta Developer App Credentials (SaaS OAuth & Graph API v21.0)
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:8000/api/v1/integrations/instagram/oauth/callback
META_API_VERSION=v21.0
META_GRAPH_BASE_URL=https://graph.facebook.com
TOKEN_ENCRYPTION_KEY=

# ---------- TIKTOK CONTENT POSTING API ----------
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ---------- PUBLIC VIDEO HOSTING ----------
PUBLIC_HOST_MODE=github_release
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_RELEASE_TAG=videos

# ---------- MAKE.COM / AUTOMATION WEBHOOK ----------
MAKE_WEBHOOK_SECRET=

# ---------- TELEGRAM NOTIFICATIONS ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------- AUTONOMY RUNTIME OVERRIDES ----------
AUTOPILOT_MOCK_MODE=false
AUTOPILOT_AUTONOMY=assisted
